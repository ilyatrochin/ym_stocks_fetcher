# Скопировать в /opt/openclaw/secrets/.env и заполнить.
# chmod 600 .env (никому кроме openclaw читать нельзя).

# === Яндекс.Маркет ===
# API-Key получить: Кабинет продавца → Настройки → API и модули → Создать API-Key
# Нужны права:
#   - чтение остатков и складов (модуль 1)
#   - чтение заказов (модуль 2)
#   - supplies-management:read-only — FBY-заявки на поставку (модуль 3)
YM_API_KEY=

# CAMPAIGN_ID (магазин) — для метода остатков
# Найти: Кабинет → Настройки → API и модули → "Идентификатор кампании"
YM_CAMPAIGN_ID=

# BUSINESS_ID (кабинет) — для метода заказов
# Это ДРУГОЙ идентификатор. Найти: тот же экран, поле "ID бизнес-аккаунта"
# или через метод GET v2/campaigns
YM_BUSINESS_ID=

# === Google Sheets ===
# ID из URL таблицы: https://docs.google.com/spreadsheets/d/<ВОТ_ЭТО>/edit
GSHEET_ID=

# Путь к JSON-ключу сервисного аккаунта Google Cloud
GOOGLE_CREDS=/opt/openclaw/secrets/gcp-sa.json

# === Telegram ===
# Бот: создать через @BotFather → /newbot → получить токен
TG_BOT_TOKEN=

# chat_id руководителя: пишет @userinfobot в чате → получает свой id
TG_ADMIN_CHAT_ID=

# === FBS-отгрузка (модуль 7, команда /fbs в боте) ===
# Нужны права ключа YM_API_KEY: inventory-and-order-processing (чтение заказов,
# ярлыки, и ЗАПИСЬ — для кнопки «Собрано» → READY_TO_SHIP).
# Используется YM_BUSINESS_ID; FBS-кампании определяются по заказам автоматически.

# ID папки на ОБЩЕМ диске Google Drive (из URL .../folders/<ВОТ_ЭТО>).
# Сервисный аккаунт из GOOGLE_CREDS добавить в общий диск «Менеджером контента».
GDRIVE_FBS_FOLDER_ID=

# Формат ярлыков: A9_HORIZONTALLY (58×40), A9 (40×58), A7 (75×120), A4
FBS_LABEL_FORMAT=A9_HORIZONTALLY

# Часовой пояс для «сегодня» (по умолчанию Europe/Moscow)
# FBS_TZ=Europe/Moscow
# Шрифт с кириллицей для листа сборки (по умолчанию DejaVu: apt install fonts-dejavu-core)
# FBS_FONT_PATH=
