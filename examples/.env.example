# Скопировать в /opt/openclaw/secrets/.env, chmod 600.

# === Яндекс.Маркет ===
# API-Key получить: Кабинет продавца → Настройки → API и модули → Создать API-Key
# Нужны права:
#   - чтение остатков и складов (модуль 1: fetch_ym_stocks.py)
#   - чтение заказов (модуль 2: fetch_ym_orders.py)
#   - supplies-management:read-only — FBY-заявки на поставку (модуль 3: fetch_ym_supplies.py)
#   - чтение отчётов / reports (для fetch_ym_report.py — ежемесячный backfill)
YM_API_KEY=

# Идентификатор кампании (числовой), показывает Кабинет → Настройки → API и модули.
YM_CAMPAIGN_ID=

# ID бизнес-аккаунта (другой числовой ID, не путать с CAMPAIGN_ID).
YM_BUSINESS_ID=

# === Google Sheets ===
# ID таблицы из URL: https://docs.google.com/spreadsheets/d/<ЭТО>/edit
GSHEET_ID=

# Путь к JSON-ключу сервисного аккаунта Google. Лежит вне репо.
GOOGLE_CREDS=/opt/openclaw/secrets/gcp-sa.json

# === Telegram ===
# Токен от @BotFather.
TG_BOT_TOKEN=

# chat_id руководителя. Узнать: написать боту, потом
# curl https://api.telegram.org/bot$TG_BOT_TOKEN/getUpdates
# или через @userinfobot.
TG_ADMIN_CHAT_ID=
